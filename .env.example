APP_NAME="KN Softic POS"

# ---- Brand identity (config/brand.php) -------------------------------------
# Every surface reads these; nothing hardcodes the company name.
BRAND_NAME="KN Softic"
BRAND_LEGAL_NAME="KN Softic"
BRAND_PRODUCT="KN Softic POS"
BRAND_TAGLINE="Cloud POS & Sales Management"
BRAND_WEBSITE="https://knsoftic.com"
BRAND_WEBSITE_LABEL="knsoftic.com"
BRAND_SUPPORT_EMAIL="support@knsoftic.com"
BRAND_SALES_EMAIL="sales@knsoftic.com"
BRAND_SUPPORT_PHONE=""
BRAND_COPYRIGHT_SINCE=2026
BRAND_VERSION="1.0.0-beta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Session timeout in minutes (#161)
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_WARN_BEFORE_MINUTES=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Security policy — see config/security.php (#63, #65)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
PASSWORD_REQUIRE_UNCOMPROMISED=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=15
PASSWORD_RESET_DECAY_MINUTES=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
