# =============================================================================
# PRODUCTION .env  (#115)
# =============================================================================
# Copy to `.env` on the server, fill in the blanks, then:
#
#     php artisan key:generate
#     php artisan migrate --force
#     php artisan pos:make-admin
#     php artisan optimize
#     php artisan pos:preflight        <-- this is the one that tells you the truth
#
# THIS FILE IS THE SAME AS .env.example WITH DIFFERENT ANSWERS. A test asserts
# the two carry the same keys, because the failure mode of a second env file is
# that somebody adds a setting to one of them and the other is quietly a year
# out of date.
#
# APP_KEY and DB_PASSWORD are deliberately EMPTY, and MAIL_USERNAME /
# MAIL_PASSWORD still say `null`. None of them is an oversight: a plausible
# placeholder in a committed file is a credential somebody eventually ships,
# and an empty one fails loudly on the first request instead.
#
# SESSION_SECURE_COOKIE has no line here on purpose -- Laravel derives it from
# APP_URL when it is unset, which is right more often than a hardcoded value.
# =============================================================================

APP_NAME="KN Softic POS"

# ---- Brand identity (config/brand.php) -------------------------------------
# Every surface reads these; nothing hardcodes the company name.
BRAND_NAME="KN Softic"
BRAND_LEGAL_NAME="KN Softic"
BRAND_PRODUCT="KN Softic POS"
BRAND_TAGLINE="Cloud POS & Sales Management"
BRAND_WEBSITE="https://knsoftic.com"
BRAND_WEBSITE_LABEL="knsoftic.com"
BRAND_SUPPORT_EMAIL="support@knsoftic.com"
BRAND_SALES_EMAIL="sales@knsoftic.com"
BRAND_SUPPORT_PHONE=""
BRAND_ADDRESS=""
# Blank uses the drawn mark, which is geometry rather than a file and so
# renders in places an image never reaches.
BRAND_LOGO_PATH=""
BRAND_COPYRIGHT_SINCE=2026
BRAND_VERSION="1.0.0-beta"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_saas
DB_USERNAME=pos_app
DB_PASSWORD=

SESSION_DRIVER=database
# Session timeout in minutes (#161)
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_WARN_BEFORE_MINUTES=5
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Security policy — see config/security.php (#63, #65)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
PASSWORD_REQUIRE_UNCOMPROMISED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=1
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=15
PASSWORD_RESET_DECAY_MINUTES=10

# ---- Response headers (config/security.php, #100) --------------------------
# NOTE there is no CSP knob. A CSP this app could pass today would need
# unsafe-inline, which permits exactly what a CSP exists to stop.
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=()"
# A max-age seen once pins that hostname to HTTPS in that browser for a year --
# localhost included, which is how a developer bricks their own machine. Off
# outside production; on once HTTPS is settled.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

# ---- Rate limits (config/security.php, #65, #100) --------------------------
# Sign-up is per HOUR: it creates a business, a user and a subscription with
# nobody signed in, and a window that resets in sixty seconds stops nothing.
REGISTER_MAX_ATTEMPTS=5
REGISTER_DECAY_MINUTES=60
SEARCH_PER_MINUTE=120
EXPORT_PER_MINUTE=20
# Deliberately loose -- a till that refuses a sale is worse than what this
# prevents. The real defence against a double submit is the idempotency key.
SALE_PER_MINUTE=120

# ---- Logging (config/logging.php, #94) -------------------------------------
# Two channels beyond the app log, kept far longer: a breach is noticed weeks
# after it happens, and a disputed figure surfaces at stock-take or year end.
SECURITY_LOG_CHANNEL=security
SECURITY_LOG_LEVEL=info
SECURITY_LOG_DAYS=180
FINANCIAL_LOG_CHANNEL=financial
FINANCIAL_LOG_LEVEL=info
FINANCIAL_LOG_DAYS=365
# A rolled-back transaction leaves no row anywhere; this is the only trace.
LOG_ROLLBACKS=true
LOG_DAILY_DAYS=14

# ---- Retention (config/audit.php, #170) ------------------------------------
# What `pos:prune` may take. It never touches anything financial (#133, #198).
AUDIT_RETENTION_DAYS=730

# ---- Uploads (config/uploads.php, #101) ------------------------------------
UPLOAD_DISK=public
UPLOAD_PRODUCT_IMAGE_MAX_KB=2048
UPLOAD_PRODUCT_IMAGE_MAX_PX=3000
UPLOAD_RECEIPT_MAX_KB=4096

# ---- Platform switches (config/platform.php, #110, #160) -------------------
# Maintenance is a DB flag, not `artisan down`: it closes the tenant app and
# the public site while leaving /admin open, so the operator is never locked
# out of the switch. These are only the shipped defaults.
PLATFORM_MAINTENANCE=false
PLATFORM_MAINTENANCE_TOKEN=
PLATFORM_REGISTRATION_OPEN=true
PLATFORM_TRIAL_PLAN_ID=

# ---- Subscription defaults (config/subscription.php) -----------------------
# Starting points only. Plans, prices and limits are operator data in the
# database -- nothing about them is decided in code (#190).
SUBSCRIPTION_CURRENCY=PKR
SUBSCRIPTION_CURRENCY_SYMBOL=Rs
SUBSCRIPTION_CURRENCY_DECIMALS=0
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_WARNING_DAYS=7
SUBSCRIPTION_EXPIRY_BEHAVIOR=read_only
# Seconds an entitlement answer may be reused within a request cycle.
SUBSCRIPTION_CACHE_TTL=300

# ---- Inventory defaults (config/inventory.php) -----------------------------
INVENTORY_ALLOW_NEGATIVE_STOCK=false
INVENTORY_VALUATION_METHOD=weighted_average
INVENTORY_EXPIRY_WARNING_DAYS=30
# The fallback when neither a variant nor a product names its own threshold.
# Blank means "never low" rather than "low at zero".
INVENTORY_DEFAULT_ALERT_QUANTITY=

# ---- Backups (config/backup.php, #95) --------------------------------------
# ⚠️ A local disk is NOT a backup. It survives a mistake and nothing else --
# not a dead disk, not a fire, not ransomware, which encrypts this folder
# along with everything else. Point BACKUP_DISK somewhere off-box.
BACKUP_DISK=local
BACKUP_PATH=backups
# Frequently NOT on PATH. On aaPanel: /www/server/mysql/bin/mysqldump
# On XAMPP: C:\xampp\mysql\bin\mysqldump.exe
BACKUP_MYSQLDUMP=
# Longer than it feels like it needs to be: the failure that most needs a
# backup is the one nobody noticed, and those surface at stock-take or month
# end -- weeks later.
BACKUP_RETENTION_DAYS=30
BACKUP_STALE_AFTER_HOURS=48

# =============================================================================
# PER-SHOP DEFAULTS
# =============================================================================
# ⚠️ These are only the STARTING values every new shop is created with. Each
# one is also a row in the settings table, and a shop that changes it in
# Settings overrides this permanently -- the key here IS the config key it
# overrides. Changing a value below moves the default for FUTURE shops and for
# any shop that never touched it; it does not reach one that did.

# ---- Money and dates (config/format.php, #155-157) -------------------------
FORMAT_CURRENCY_CODE=PKR
FORMAT_CURRENCY_SYMBOL=Rs
FORMAT_CURRENCY_POSITION=before
FORMAT_DECIMALS=2
FORMAT_THOUSANDS_SEPARATOR=","
FORMAT_DECIMAL_SEPARATOR="."
FORMAT_DATE="d M Y"
FORMAT_TIME="H:i"

# ---- The till (config/pos.php) ---------------------------------------------
POS_INVOICE_FORMAT="{PREFIX}-{YYYY}{MM}-{SEQ:5}"
POS_INVOICE_PREFIX=INV
# `business` = one number series for the whole shop; `branch` = one per branch.
POS_INVOICE_SEQUENCE_SCOPE=business
POS_PAYMENT_METHODS="cash,card,bank_transfer,qr,credit"
# Which of the above count as cash for the drawer. Get this wrong and the till
# reconciliation is wrong every single day.
POS_CASH_METHODS=cash
# The method that takes no money -- it charges the customer's account instead.
POS_CREDIT_METHOD=credit
POS_PAYMENT_QR_PATH=
# 0 = no rounding. Set to 1 where the smallest coin in circulation is 1.
POS_CASH_ROUNDING=0
POS_ALLOW_WALK_IN=true
POS_REQUIRE_CASH_SESSION=false
# `pos:expire-holds` reads this per shop, hourly.
POS_HOLD_EXPIRY_HOURS=24

# ---- The receipt (config/pos.php, #143) ------------------------------------
POS_RECEIPT_WIDTH=80mm
POS_RECEIPT_HEADER=
POS_RECEIPT_FOOTER="Thank you for shopping with us."
POS_RECEIPT_TAX_NUMBER=
POS_RECEIPT_SHOW_LOGO=false
POS_RECEIPT_SHOW_TAX=true
POS_RECEIPT_SHOW_QR=false
POS_RECEIPT_AUTO_PRINT=false

# ---- Discounts (config/sales.php, #141) ------------------------------------
# This is the SHOP's ceiling. A person's own cap is on their role, and somebody
# with no personal cap falls back to this -- never to unlimited.
SALES_ALLOW_LINE_DISCOUNT=true
SALES_ALLOW_INVOICE_DISCOUNT=true
SALES_MAX_DISCOUNT_PERCENT=100

# ---- Seeding ---------------------------------------------------------------
# `DemoSeeder` refuses to run when APP_ENV=production. Set this only for a
# staging box that reports itself as production (#191).
ALLOW_DEMO_SEED=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
